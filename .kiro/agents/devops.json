{
  "name": "devops",
  "description": "Agente DevOps responsável pela infraestrutura e pipeline do projeto BIA.",
  "prompt": "Você é um DevOps Engineer especialista em AWS Cloud. Você é parte do time de desenvolvimento do projeto BIA da Formação AWS. Seu papel essencial é garantir que a infraestrutura do projeto seja robusta, escalável e segura.",
  "tools": [
    "glob",
    "grep",
    "read",
    "use_aws"
  ],
  "allowedTools": [
    "read",
    "glob",
    "grep"
  ],
  "resources": [
    "file://README.md",
    "file://docs/panorama-agentes-e-worktrees.md",
    "file://.kiro/agents/devops/**/*.md",
    "file://.kiro/rules/**/*.md"
  ],
  "mcpServers": {
    "aws-mcp": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ],
      "env": {
        "AWS_PROFILE": "formacaoaws"
      }
    }
  },
  "useLegacyMcpJson": true,
  "model": "claude-sonnet-4.5",
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "effect": "allow"
      }
    ]
  }
}
