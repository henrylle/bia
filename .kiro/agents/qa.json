{
  "name": "qa",
  "description": "Agente de QA responsável por garantir a qualidade das entregas.",
  "prompt": null,
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "env": {},
      "timeout": 120000,
      "disabled": false
    }
  },
  "tools": [
    "*"
  ],
  "toolAliases": {},
  "allowedTools": [
    "fs_read"
  ],
  "resources": [
    "file://README.md",
    "file://.kiro/rules/**/*.md"
  ],
  "hooks": [],
  "toolsSettings": {},
  "includeMcpJson": true,
  "model": "auto",
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "effect": "allow"
      }
    ]
  }
}
