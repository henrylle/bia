{
  "mcpServers": {
    "postgres": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2",
        "postgres-mcp",
        "--access-mode=unrestricted"
      ],
      "env": {
        "DATABASE_URI": "postgresql://postgres:postgres@localhost:5433/bia"
      }
    }
  }
}
//Source: https://github.com/crystaldba/postgres-mcp
// Roda como processo local, nao via docker run: container de MCP sobrevive
// quando o cliente e morto (--rm so age se o container sair sozinho).
// A porta 5433 e a que o compose.yml expoe no host (5433:5432).
// O pin mcp<2 e necessario: o SDK 2.0.0 removeu mcp.server.fastmcp.
